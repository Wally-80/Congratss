{
  "name": "congratss",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cap:copy": "npm run build && npx cap copy",
    "cap:sync": "npm run build && npx cap sync",
    "cap:doctor": "npx cap doctor",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "test:security": "firebase emulators:exec --project demo-congratss --config firebase.emulators.json --only auth,firestore,storage \"node --test --test-concurrency=1 tests/security.test.mjs tests/publisher.integration.mjs\"",
    "test:unit": "node --test tests/card.test.mjs tests/date.test.mjs tests/publisher.test.mjs",
    "publisher": "node --experimental-strip-types services/publisher/server.mjs",
    "test:e2e": "playwright test",
    "test:e2e:emulators": "firebase emulators:exec --project demo-congratss --config firebase.emulators.json --only auth,firestore,storage \"playwright test\""
  },
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/ios": "^8.2.0",
    "@capacitor/local-notifications": "^8.0.2",
    "@capacitor/push-notifications": "^8.0.3",
    "express": "^5.3.0",
    "firebase": "12.19.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.563.0",
    "next": "16.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "firebase-tools": "^15.34.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.6"
    }
  }
}
