rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function admin() {
      return request.auth != null && (
        request.auth.token.get('admin', false) == true
        || (request.auth.token.get('email_verified', false) == true
          && request.auth.token.get('email', '') in ['walterrpom@gmail.com', 'walterciitop@gmail.com'])
        || (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          && (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin'
            || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true))
      );
    }
    match /greeting_cards/{path=**} {
      allow read: if true;
      allow create, update: if admin() && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('(image/(png|jpeg|webp|gif)|video/mp4)');
      allow delete: if admin();
    }
    // Existing public links are preserved. New user uploads stay local to the device.
    match /user_uploads/{path=**} { allow read: if true; allow write: if false; }
    match /{path=**} { allow read, write: if false; }
  }
}
